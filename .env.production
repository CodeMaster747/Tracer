# Firebase web config — these values are public (they ship in the client bundle).
# Security comes from Firebase Auth rules + App Check, not from hiding these.
# DO NOT add real secrets here (server-side keys, admin SDK creds, etc.) — use GitHub secrets instead.
VITE_FIREBASE_API_KEY=AIzaSyBvw171gXE5QRsQEiFGmR87WWO2-EU-mT4
# Use the hosting domain (same origin as the app) so the OAuth helper at
# /__/auth/* is served on the same origin. This avoids the "missing initial
# state" error in storage-partitioned browsers (Safari, Brave, recent Chrome)
# that happens when signInWithRedirect bounces through firebaseapp.com.
VITE_FIREBASE_AUTH_DOMAIN=tracer-137d2.web.app
VITE_FIREBASE_PROJECT_ID=tracer-137d2
VITE_FIREBASE_STORAGE_BUCKET=tracer-137d2.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=506274030823
VITE_FIREBASE_APP_ID=1:506274030823:web:c5ddaa412476bd2fe36e42
